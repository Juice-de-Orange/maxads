# Copy to .env and adjust. Every variable is optional; the defaults run locally.

# Public base URL of this service. Embed snippets point here, so it must be the
# address foreign pages can reach (e.g. https://ads.example.com behind your proxy).
MAXADS_PUBLIC_URL=http://localhost:8080

# Host port of the Docker quick start (docker-compose.yml). If you change it,
# change the port in MAXADS_PUBLIC_URL above to match -- otherwise the embed
# snippets keep pointing at 8080.
MAXADS_PORT=8080

# Password for the first admin account ("admin"). Leave empty to have one
# generated on the first start: it is printed once to stderr
# (`docker compose logs web`) and must be changed on the first login.
MAXADS_ADMIN_PASSWORD=

# Session-cookie key and the salt of the daily visitor hash. Leave empty to have
# random values generated once and stored in the data directory.
MAXADS_SECRET_KEY=
MAXADS_COUNT_SALT=

# Largest accepted upload in MB.
MAXADS_MAX_UPLOAD_MB=512

# Mount guard: with 1 the service refuses to start unless $MAXADS_BASE/.mounted
# exists (for a data directory on a separate disk). The Docker image sets 0,
# because a named volume cannot drop out on its own.
# MAXADS_REQUIRE_MOUNT=0
